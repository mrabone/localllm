# .env.example
# Example environment variables for the localllm services

# PostgreSQL Connection Details
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=rag_db
PG_USER=user
PG_PASSWORD=password
PG_COLLECTION_NAME=reading_list_embs

# Common Ollama Connection Details
OLLAMA_BASE_URL=http://127.0.0.1:11434

# RAG Pipeline
RAG_OLLAMA_MODEL=embeddinggemma
CONCURRENT_REQUESTS=5
REQUEST_DELAY=1

# Server: chat model and context-window settings
SERVER_OLLAMA_MODEL=custom-chatbot-model
SERVER_MAX_RECENT=10
SERVER_THRESHOLD=20

# Server: RAG integration
SERVER_ENABLE_RAG=false
SERVER_RAG_MAX_DISTANCE=0.5
SERVER_RAG_K=3

# Server: network
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CLI: where to reach the server (when running locally, not via Docker)
SERVER_URL=http://127.0.0.1:8000
