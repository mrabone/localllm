# .env.example
# Example environment variables for the RAG and CLI pipelines

# PostgreSQL Connection Details
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=rag_db
PG_USER=user
PG_PASSWORD=password
PG_COLLECTION_NAME=reading_list_embs

# Common Ollama Connection Details
OLLAMA_BASE_URL=http://127.0.0.1:11434

# RAG Specific Ollama Model
RAG_OLLAMA_MODEL=embeddinggemma
CONCURRENT_REQUESTS=5
REQUEST_DELAY=1

# CLI Specific Ollama Model and Configuration
CLI_OLLAMA_MODEL=custom-chatbot-model
CLI_MAX_RECENT=10
CLI_THRESHOLD=20

# CLI RAG Configuration
CLI_ENABLE_RAG=false
CLI_RAG_MAX_DISTANCE=0.5
CLI_RAG_K=3
