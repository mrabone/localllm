# .env.example
# Example environment variables for the localllm services

# PostgreSQL Connection Details
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=rag_db
PG_USER=user
PG_PASSWORD=password
PG_COLLECTION_NAME=reading_list_embs

# Common Ollama Connection Details
OLLAMA_BASE_URL=http://127.0.0.1:11434

# RAG Pipeline
RAG_OLLAMA_MODEL=embeddinggemma
CONCURRENT_REQUESTS=5
REQUEST_DELAY=1

# RAG retrieval (shared by MCP server and any other consumer)
RAG_K=3
RAG_MAX_DISTANCE=0.5

# MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_ENABLE_RAG=false

# Server: chat model and context-window settings
SERVER_OLLAMA_MODEL=custom-chatbot-model
SERVER_OLLAMA_NUM_CTX=8192
SERVER_MEMORY_WINDOW_SIZE=10
SERVER_MEMORY_LONG_TERM_MAX=3

# Server: network
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Server: MCP connection (when running locally, not via Docker)
MCP_SERVER_URL=http://127.0.0.1:8001

# CLI: where to reach the server (when running locally, not via Docker)
SERVER_URL=http://127.0.0.1:8000
